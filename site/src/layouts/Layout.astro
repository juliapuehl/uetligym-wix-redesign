---
import "../styles/global.css";
import { WIX_CLIENT_ID } from "../lib/wix";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Active nav item: "home" | "angebot" | "preise" | "community" | "kontakt" */
  nav?: string;
}
const {
  title = "Uetligym – Stronger Together",
  description = "Gruppenkurse, Personal Training und Sauna in einer Community, die dich weiterbringt.",
  image,
  nav,
} = Astro.props;
const cur = (key: string) => (nav === key ? "page" : undefined);
---
<!doctype html>
<html lang="de-CH" data-wix-client={WIX_CLIENT_ID}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={image} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/">UETLIGYM</a>
      <button class="menu-btn" aria-label="Menü" aria-expanded="false" aria-controls="nav">≡</button>
      <nav class="nav" id="nav" aria-label="Hauptnavigation">
        <a href="/" class="only-m" aria-current={cur("home")}>Home</a>
        <a href="/angebot" aria-current={cur("angebot")}>Unser Angebot</a>
        <a href="/preise" aria-current={cur("preise")}>Preise</a>
        <a href="/angebot#stundenplan">Stundenplan</a>
        <a href="/community" aria-current={cur("community")}>Community</a>
        <a href="/kontakt" aria-current={cur("kontakt")}>Kontakt</a>
      </nav>
      <a class="btn oak header-cta" href="/angebot#stundenplan">Jetzt buchen</a>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap inner">
      <div class="brand">UETLIGYM<span class="only-d"> · <a href="/kontakt">Kontakt</a> · <a href="/kontakt#social">Social</a></span></div>
      <div class="links"><span class="only-m"><a href="/kontakt">Kontakt</a> · <a href="/kontakt#social">Social</a> · </span>AGB · Hausordnung<span class="only-d"> · Saunaordnung</span> · Datenschutz<span class="only-d">erklärung</span></div>
    </div>
  </footer>
  <!-- Menü und Wix-Client für Formulare und Event-Anmeldungen -->
  <script is:inline src="/assets/site.js"></script>
  <!-- Popups aus dem CMS (Tabelle "Popups") -->
  <script>
    import "../scripts/popups.js";
  </script>
  <slot name="scripts" />
</body>
</html>
