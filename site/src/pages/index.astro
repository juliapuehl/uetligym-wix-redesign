---
// Startseite. Das Hero-Bild oder -Video kommt aus dem CMS (Dashboard → CMS → "Startseite" → Feld "Hero-Bild oder -Video").
// Ohne Eintrag bleibt das Standardbild stehen.
import Layout from "../layouts/Layout.astro";
import Media from "../components/Media.astro";
import { queryCollection, mediaOf, safe } from "../lib/wix";

const FALLBACK_ID = "6b26aa_a794100dd6234b1b833e96c5b5d50cc3~mv2.png";
const [start] = await safe(queryCollection("Startseite", { sort: [{ fieldName: "_createdDate", order: "ASC" }], paging: { limit: 1, offset: 0 } }), []);
let hero = mediaOf(start?.heroMedium);
if (hero?.kind === "image" && hero.src.includes(FALLBACK_ID)) hero = null;
---
<Layout nav="home">
  <section class="hero">
    <div class="wrap stack">
      <div class="hero-card">
        {hero ? <Media media={hero} w={750} h={400} class="bg" alt="Training im Uetligym" /> : <img class="bg" src="https://static.wixstatic.com/media/6b26aa_e1c3527e935a474d90397ea48e8160ea~mv2.png" alt="Training im Uetligym" />}
        <div class="logo-line" aria-hidden="true"><img src="https://static.wixstatic.com/media/6b26aa_4f6edce5f0d0420f87c155028778ed75~mv2.png" alt=""></div>
        <h1 class="claim"><span class="top">Stronger Together</span><span class="bottom">Healthier for Life</span></h1>
      </div>
      <p class="intro-text">Gruppenkurse, Personal Training und Sauna in einer Community, die dich weiterbringt.</p>
      <div class="btn-row">
        <a class="btn oak-dark-text" href="/preise#newcomer">Newcomer Offer</a>
        <a class="btn turq" href="/angebot#stundenplan">Stundenplan</a>
      </div>
    </div>
    <div class="hero-d only-d" aria-hidden="true">
      {hero ? <Media media={hero} w={1920} h={810} desktop /> : <img src="https://static.wixstatic.com/media/6b26aa_a794100dd6234b1b833e96c5b5d50cc3~mv2.png" alt="" />}
      <img src="https://static.wixstatic.com/media/6b26aa_69b65a8c978343d3b03dcb49eaa730d5~mv2.png" alt="">
    </div>
    <div class="hero-d-content only-d">
      <p class="h1" role="heading" aria-level="1" style="margin:0;font-weight:700;font-size:60px;line-height:1.04;text-transform:uppercase;text-shadow:4px 4px 4px rgba(0,0,0,0.65)">Stronger Together,<br>Healthier for Life</p>
      <p>Gruppenkurse, Personal Training und Sauna in einer Community, die dich weiterbringt.</p>
      <div class="btn-row">
        <a class="btn oak-dark-text" href="/preise#newcomer">Newcomer Offer</a>
        <a class="btn turq" href="/angebot#stundenplan">Stundenplan</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-bottom:16px">
    <div class="wrap stack">
      <h2>Entdecke unser Studio</h2>
      <div class="row-scroll">
        <a class="tile" href="/angebot#gruppenkurse"><div class="ph"><img src="https://static.wixstatic.com/media/6b26aa_982cb37804044006963b429ca5f8e62e~mv2.png/v1/fill/w_400,h_300,al_c,q_90/6b26aa_982cb37804044006963b429ca5f8e62e~mv2.png" alt="" loading="lazy"></div><span class="cap">Gruppenkurse</span></a>
        <a class="tile" href="/angebot#stundenplan"><div class="ph"><img src="https://static.wixstatic.com/media/6b26aa_96daba5409fe477a96e81053b58a52d8~mv2.png/v1/fill/w_400,h_300,al_c,q_90/6b26aa_96daba5409fe477a96e81053b58a52d8~mv2.png" alt="" loading="lazy"></div><span class="cap">Open Gym</span></a>
        <a class="tile" href="/angebot#ansatz"><div class="ph"><img src="https://static.wixstatic.com/media/6b26aa_9260a64838ac4b3d9c4d07cf48f8f989~mv2.png/v1/fill/w_400,h_300,al_c,q_90/6b26aa_9260a64838ac4b3d9c4d07cf48f8f989~mv2.png" alt="" loading="lazy"></div><span class="cap">Sauna</span></a>
        <a class="tile" href="/angebot#personal-training"><div class="ph"><img src="https://static.wixstatic.com/media/6b26aa_7dc831949e474998832dd820df5886a5~mv2.png/v1/fill/w_400,h_300,al_c,q_90/6b26aa_7dc831949e474998832dd820df5886a5~mv2.png" alt="" loading="lazy"></div><span class="cap">Personal Training</span></a>
        <a class="tile" href="/angebot#ansatz"><div class="ph"><img src="https://static.wixstatic.com/media/6b26aa_28d6a5dbe4a247948dfbe73106c7f7ab~mv2.png/v1/fill/w_400,h_300,al_c,q_90/6b26aa_28d6a5dbe4a247948dfbe73106c7f7ab~mv2.png" alt="" loading="lazy"></div><span class="cap">Ernährungs<wbr />beratung</span></a>
        <a class="tile" href="/angebot#gruppenkurse"><div class="ph"><img src="https://static.wixstatic.com/media/6b26aa_e7d3c4ce5b25448aae71f5dbc605e3a4~mv2.png/v1/fill/w_400,h_300,al_c,q_90/6b26aa_e7d3c4ce5b25448aae71f5dbc605e3a4~mv2.png" alt="" loading="lazy"></div><span class="cap">Hyrox</span></a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap stack">
      <h2>Training, das in dein Leben passt – nicht umgekehrt</h2>
      <div class="trainings">
        <div class="list-item">
          <div class="ph"><picture><source media="(min-width: 900px)" srcset="https://static.wixstatic.com/media/6b26aa_e1c3527e935a474d90397ea48e8160ea~mv2.png/v1/fill/w_740,h_440,al_c,q_90/6b26aa_e1c3527e935a474d90397ea48e8160ea~mv2.png"><img src="https://static.wixstatic.com/media/6b26aa_afbdc0b670904102bdb16a7ce3a461a9~mv2.png/v1/fill/w_128,h_96,al_c,q_90/6b26aa_afbdc0b670904102bdb16a7ce3a461a9~mv2.png" alt="Hyrox Simulation" loading="lazy"></picture></div>
          <div class="txt"><p class="title16">Hyrox Simulation</p><span class="meta">60 Min · Alle Levels</span></div>
        </div>
        <div class="list-item">
          <div class="ph"><picture><source media="(min-width: 900px)" srcset="https://static.wixstatic.com/media/6b26aa_7d367f055154403bad909630d829a469~mv2.png/v1/fill/w_740,h_440,al_c,q_90/6b26aa_7d367f055154403bad909630d829a469~mv2.png"><img src="https://static.wixstatic.com/media/6b26aa_b64f9537efd64d26b649c899d25c3424~mv2.png/v1/fill/w_128,h_96,al_c,q_90/6b26aa_b64f9537efd64d26b649c899d25c3424~mv2.png" alt="Strength Basics" loading="lazy"></picture></div>
          <div class="txt"><p class="title16">Strength Basics</p><span class="meta">60 Min · Alle Levels</span></div>
        </div>
        <div class="list-item only-d">
          <div class="ph shade"><img src="https://static.wixstatic.com/media/6b26aa_b04e77e3c1f840b5aa883cf4cf88a715~mv2.png/v1/fill/w_740,h_440,al_c,q_90/6b26aa_b04e77e3c1f840b5aa883cf4cf88a715~mv2.png" alt="Kettlebells &amp; More" loading="lazy"></div>
          <div class="txt"><p class="title16">Kettlebells &amp; More</p><span class="meta">60 Min · Alle Levels</span></div>
        </div>
      </div>
      <div class="stack only-m" style="gap:6px">
        <a class="link-turq" href="/angebot">Alle Kurse →</a>
        <a style="color:var(--accent-color-turquoise);font-weight:600" href="/preise#newcomer">Not sure where to start? Get our <strong style="font-weight:800;color:var(--error-color)">Newcomer Offer</strong> →</a>
      </div>
      <div class="trainings-more only-d"><a class="link-turq" href="/angebot">Alle Kurse →</a></div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap split">
      <div class="ph wide"><img src="https://static.wixstatic.com/media/6b26aa_9260a64838ac4b3d9c4d07cf48f8f989~mv2.png" alt="Sauna im Uetligym" loading="lazy"></div>
      <div class="split-text">
        <h2>Unser Ansatz – mehr als nur Gewichte</h2>
        <p class="body">Wir denken Training ganzheitlich: Bewegung, Erholung und Ernährung gehören zusammen.</p>
        <div class="inline-links">
          <a href="/angebot#ansatz"><span class="only-m">Sauna ·</span><span class="only-d">Sauna →</span></a>
          <a href="/angebot#ansatz"><span class="only-m">Ernährung ·</span><span class="only-d">Ernährungsberatung →</span></a>
          <a href="/community#events"><span class="only-m">Events ·</span><span class="only-d">Events →</span></a>
          <a href="/blog"><span class="only-m">Blog →</span><span class="only-d">Zum Blog →</span></a>
        </div>
        <div class="newcomer only-d">
          <p>Nicht sicher, wo du anfangen sollst?</p>
          <a class="btn oak-dark-text" href="/preise#newcomer">Newcomer Offer</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band section trainers" style="padding-bottom:16px">
    <img class="bg" src="https://static.wixstatic.com/media/6b26aa_4e74176bd41545c58105a8244b997d01~mv2.png" alt="" aria-hidden="true">
    <div class="wrap stack">
      <h2>Unsere Trainer</h2>
      <div class="avatars">
        <img src="https://static.wixstatic.com/media/6b26aa_74b7d89b875046b2a37ca2fad1306a2d~mv2.png" alt="Trainer" loading="lazy">
        <img src="https://static.wixstatic.com/media/6b26aa_defdab8eb794462a977afedf4683e28d~mv2.png" alt="Trainer" loading="lazy">
        <img src="https://static.wixstatic.com/media/6b26aa_03b71ef71b484df5a235a1df04fa5251~mv2.png" alt="Trainerin" loading="lazy">
        <img src="https://static.wixstatic.com/media/6b26aa_8d3dfe2d686f4fafa372ee7eb7c1a469~mv2.png" alt="Trainer" loading="lazy">
        <img src="https://static.wixstatic.com/media/6b26aa_1040387c2e664ced888c68800842addc~mv2.png" alt="Trainerin" loading="lazy">
      </div>
    </div>
  </section>

  <section class="section tight end">
    <div class="wrap stack">
      <h2>Kunden Reviews – 5.0 ★ (48)</h2>
      <div class="reviews">
        <div class="card beige review">
          <p style="margin:0">„Beste Community, super Trainer, moderne Geräte.“</p>
          <span class="muted">– Google Review</span>
        </div>
      </div>
    </div>
  </section>
</Layout>
